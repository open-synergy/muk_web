<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <function model="ir.config_parameter" name="set_param">
      <value eval="'pwa.manifest.name'"/>
      <value eval="'AURA'"/>
  </function>

  <function model="ir.config_parameter" name="set_param">
      <value eval="'pwa.manifest.short_name'"/>
      <value eval="'AURA'"/>
  </function>  

  <function model="ir.config_parameter" name="set_param">
      <value eval="'pwa.manifest.background_color'"/>
      <value eval="'#303030'"/>
  </function>    

  <function model="ir.config_parameter" name="set_param">
      <value eval="'pwa.manifest.theme_color'"/>
      <value eval="'#303030'"/>
  </function>      
</odoo>	

